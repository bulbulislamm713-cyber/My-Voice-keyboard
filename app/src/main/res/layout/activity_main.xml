<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/welcome_message"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keyboard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="16sp" />

        <Button
            android:id="@+id/enable_keyboard_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/enable_keyboard" />

        <Button
            android:id="@+id/choose_keyboard_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_keyboard" />

        <TextView
            style="@style/SectionHeading"
            android:text="@string/api_key_heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/api_privacy_notice" />

        <EditText
            android:id="@+id/api_key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_key_hint"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:id="@+id/api_key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save_api_key_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save_api_key" />

            <Button
                android:id="@+id/remove_api_key_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remove_api_key" />
        </LinearLayout>

        <TextView
            style="@style/SectionHeading"
            android:text="@string/microphone_heading" />

        <TextView
            android:id="@+id/microphone_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/request_microphone_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/request_microphone" />

        <TextView
            style="@style/SectionHeading"
            android:text="@string/audio_heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_privacy_notice" />

        <Button
            android:id="@+id/choose_audio_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_audio" />

        <TextView
            android:id="@+id/audio_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/copy_transcript_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_transcript" />

        <TextView
            style="@style/SectionHeading"
            android:text="@string/learning_heading" />

        <EditText
            android:id="@+id/learning_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/learning_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/learn_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/learn_button" />

        <TextView
            android:id="@+id/learning_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/learning_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/copy_learning_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_learning" />
    </LinearLayout>
</ScrollView>
